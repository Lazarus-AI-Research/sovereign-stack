#!/usr/bin/env bash
# Minimal Docker CLI fixture for non-mutating installer lifecycle tests.
set -euo pipefail
while [[ "${1:-}" == --context || "${1:-}" == --config ]]; do
  shift 2
done
case "${1:-}" in
  context)
    [[ "${2:-}" == show ]] || exit 2
    printf 'fixture-context\n'
    exit 0
    ;;
  inspect)
    [[ -n "${SOVEREIGN_TEST_DOCKER_OWNER:-}" ]] || exit 1
    if [[ " $* " == *" --format "* ]]; then
      printf '%s\n' "$SOVEREIGN_TEST_DOCKER_OWNER"
    fi
    exit 0
    ;;
  info)
    case "$*" in
      *'{{.Architecture}}'*)
        if [[ -n "${DOCKER_CONFIG:-}" ]]; then
          printf 'arm64\n'
        elif [[ -n "${SOVEREIGN_TEST_DOCKER_ARCH:-}" ]]; then
          printf '%s\n' "$SOVEREIGN_TEST_DOCKER_ARCH"
        elif [[ "${SOVEREIGN_TEST_UNAME_M:-arm64}" == x86_64 ]]; then
          printf 'amd64\n'
        else
          printf 'arm64\n'
        fi
        ;;
      *'{{json .Runtimes}}'*) printf '{"nvidia":{}}\n' ;;
    esac
    exit 0
    ;;
  version)
    [[ " $* " == *" --format "* ]] && printf '1.52\n'
    exit 0
    ;;
  pull|load) exit 0 ;;
  save)
    shift
    [[ "${1:-}" == -o && -n "${2:-}" ]] || exit 2
    : > "$2"
    exit 0
    ;;
  image)
    [[ "${2:-}" == inspect ]] || exit 2
    if [[ " $* " == *" --format "* ]]; then
      printf 'sha256:%064d %s\n' 1 1048576
    fi
    exit 0
    ;;
  volume) exit 0 ;;
  run)
    if [[ "$*" == *'df -Pk /'* ]]; then
      printf '99999999\n'
      exit 0
    fi
    previous=""
    for argument in "$@"; do
      if [[ "$previous" == --mount && "$argument" == type=bind,source=*,target=* ]]; then
        source_path="${argument#type=bind,source=}"
        source_path="${source_path%,target=*}"
        printf 'container-ok\n' > "$source_path/container-written"
      fi
      previous="$argument"
    done
    if [[ " $* " == *" -d "* ]]; then printf 'fixture-probe-container\n'; fi
    exit 0
    ;;
  port)
    printf '127.0.0.1:54321\n'
    exit 0
    ;;
  rm) exit 0 ;;
  compose)
    case " ${*:-} " in
      *" version --short "*) printf '5.5.0\n'; exit 0 ;;
      *" version "*|*" config "*|*" down "*) exit 0 ;;
    esac
    ;;
esac
echo "docker fixture: unsupported command: $*" >&2
exit 2
