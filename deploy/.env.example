# Sovereign Stack environment configuration.
# Copy to .env in this directory and edit the values.
#
# Production deployments must use immutable version tags (design.md §7).

# ── Release ──────────────────────────────────────────────────────────────────
SOVEREIGN_VERSION=0.1.0-dev

# ── Lazarus images (keep tags in sync with SOVEREIGN_VERSION) ────────────────
SOVEREIGN_CONTROL_IMAGE=ghcr.io/lazarus-ai-research/sovereign-control:0.1.0-dev
SOVEREIGN_DOCKER_PROXY_IMAGE=ghcr.io/lazarus-ai-research/sovereign-docker-proxy:0.1.0-dev
SOVEREIGN_EVALS_IMAGE=ghcr.io/lazarus-ai-research/sovereign-evals:0.1.0-dev
# Base runtime image; the compose.runtime.<profile>.yml overlay overrides this.
SOVEREIGN_RUNTIME_IMAGE=ghcr.io/lazarus-ai-research/sovereign-runtime:cpu-x86_64-0.1.0-dev

# ── Third-party images (TODO: pin immutable versions before release) ─────────
ANYTHINGLLM_VERSION=latest
LITELLM_IMAGE=ghcr.io/berriai/litellm:main-stable
PHOENIX_VERSION=latest
PROMETHEUS_VERSION=latest
GRAFANA_VERSION=latest
LOKI_VERSION=latest
OTEL_VERSION=latest

# ── Ingress ──────────────────────────────────────────────────────────────────
HTTP_PORT=80
HTTPS_PORT=443

# ── Sovereign Workspace (AnythingLLM → Gateway → pgvector, design.md §16) ────
STORAGE_DIR=/app/server/storage
DISABLE_TELEMETRY=true
LLM_PROVIDER=generic-openai
GENERIC_OPEN_AI_BASE_PATH=http://sovereign-gateway:4000/v1
# Dev default: the LiteLLM master key. Production: a scoped virtual key.
GENERIC_OPEN_AI_API_KEY=sk-change-me
GENERIC_OPEN_AI_MODEL_PREF=assistant-large
GENERIC_OPEN_AI_MODEL_TOKEN_LIMIT=8192
EMBEDDING_ENGINE=generic-openai
EMBEDDING_BASE_PATH=http://sovereign-gateway:4000/v1
GENERIC_OPEN_AI_EMBEDDING_API_KEY=sk-change-me
EMBEDDING_MODEL_PREF=embedding-omni-default
VECTOR_DB=pgvector
PGVECTOR_CONNECTION_STRING=postgresql://sovereign:change-me@postgres:5432/vectors

# ── Secrets (change every value below) ───────────────────────────────────────
POSTGRES_USER=sovereign
POSTGRES_PASSWORD=change-me
CONTROL_DATABASE_URL=postgres://sovereign:change-me@postgres:5432/sovereign_control?sslmode=disable
# LiteLLM reads DATABASE_URL for its own state database.
DATABASE_URL=postgres://sovereign:change-me@postgres:5432/litellm
LITELLM_MASTER_KEY=sk-change-me
SOVEREIGN_RUNTIME_API_KEY=change-me
DOCKER_PROXY_TOKEN=change-me-proxy-token
# Active runtime config file, as seen by Sovereign Control via the /sovereign mount.
RUNTIME_CONFIG_PATH=/sovereign/config/runtime.yaml
