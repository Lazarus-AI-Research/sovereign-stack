# Sovereign Stack environment configuration.
# Copy to .env in this directory and edit the values.
#
# Production deployments must use immutable version tags (design.md §7).

# ── Release ──────────────────────────────────────────────────────────────────
SOVEREIGN_VERSION=0.1.0-rc.1
SOVEREIGN_PROFILE=cuda-x86_64
SOVEREIGN_RELEASE_ROOT=/opt/sovereign/current
# Set these to `id -u` and `id -g`; the installer fills them automatically.
SOVEREIGN_HOST_UID=1000
SOVEREIGN_HOST_GID=1000

# ── Lazarus images (keep tags in sync with SOVEREIGN_VERSION) ────────────────
SOVEREIGN_CONTROL_IMAGE=ghcr.io/lazarus-ai-research/sovereign-control:0.1.0-rc.1
SOVEREIGN_DOCKER_PROXY_IMAGE=ghcr.io/lazarus-ai-research/sovereign-docker-proxy:0.1.0-rc.1
SOVEREIGN_EVALS_IMAGE=ghcr.io/lazarus-ai-research/sovereign-evals:0.1.0-rc.1
SOVEREIGN_WORKSPACE_IMAGE=ghcr.io/lazarus-ai-research/sovereign-workspace:0.1.0-rc.1
# Base runtime image; the certified-profile overlay selects the final variant.
SOVEREIGN_RUNTIME_IMAGE=ghcr.io/lazarus-ai-research/sovereign-runtime:cuda-x86_64-0.1.0-rc.1
SOVEREIGN_EMBEDDINGS_IMAGE=ghcr.io/lazarus-ai-research/sovereign-embeddings:0.1.0-rc.1
SOVEREIGN_EMBEDDINGS_BASE_URL=http://sovereign-embeddings:42666/v1

# ── Third-party images (immutable tested digests) ────────────────────────────
CADDY_IMAGE=caddy@sha256:af5fdcd76f2db5e4e974ee92f96ee8c0fc3edb55bd4ba5032547cbf3f65e486d
LITELLM_IMAGE=ghcr.io/berriai/litellm@sha256:f46d672e9d12a84e5dde046ff3865e0bf323e49f9f9b8eb08cd33c1713ea9627
PGVECTOR_IMAGE=pgvector/pgvector@sha256:1d533553fefe4f12e5d80c7b80622ba0c382abb5758856f52983d8789179f0fb
PHOENIX_IMAGE=arizephoenix/phoenix@sha256:0826e5c6247d012bf8cfb58df5dd9778b26ebb7f9b1afac577a8e0bb3d83606f
PROMETHEUS_IMAGE=prom/prometheus@sha256:3c42b892cf723fa54d2f262c37a0e1f80aa8c8ddb1da7b9b0df9455a35a7f893
GRAFANA_IMAGE=grafana/grafana@sha256:121a7a9ece6dc10b969f1f96eed64b4f07dfac0d0b8abc070f7cb83bbde86f63
LOKI_IMAGE=grafana/loki@sha256:70b9f699fc9bb868b62f1cfd4f787dfa50242f1fd92e6089787d5d7daea75fe8
OTEL_IMAGE=otel/opentelemetry-collector-contrib@sha256:125bdbeb7590cc1952c5b3430ecf14063568980c2c93d5b38676cc0446ed8108

# ── Ingress ──────────────────────────────────────────────────────────────────
SOVEREIGN_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8880

# ── Sovereign Workspace (AnythingLLM → Gateway → pgvector, design.md §16) ────
STORAGE_DIR=/app/server/storage
DISABLE_TELEMETRY=true
LLM_PROVIDER=generic-openai
GENERIC_OPEN_AI_BASE_PATH=http://sovereign-gateway:4000/v1
# Dev default: the LiteLLM master key. Production: a scoped virtual key.
GENERIC_OPEN_AI_API_KEY=sk-change-me
GENERIC_OPEN_AI_MODEL_PREF=assistant-large
GENERIC_OPEN_AI_MODEL_TOKEN_LIMIT=8192
EMBEDDING_ENGINE=generic-openai
EMBEDDING_BASE_PATH=http://sovereign-gateway:4000/v1
GENERIC_OPEN_AI_EMBEDDING_API_KEY=sk-change-me
EMBEDDING_MODEL_PREF=embedding-gemma-default
GENERIC_OPEN_AI_EMBEDDING_PASSAGE_PREFIX="title: none | text: "
GENERIC_OPEN_AI_EMBEDDING_QUERY_PREFIX="task: search result | query: "
VECTOR_DB=pgvector
PGVECTOR_CONNECTION_STRING=postgresql://sovereign:change-me@postgres:5432/vectors

# ── Secrets (change every value below) ───────────────────────────────────────
POSTGRES_USER=sovereign
POSTGRES_PASSWORD=change-me
CONTROL_DATABASE_URL=postgres://sovereign:change-me@postgres:5432/sovereign_control?sslmode=disable
# LiteLLM reads DATABASE_URL for its own state database.
DATABASE_URL=postgres://sovereign:change-me@postgres:5432/litellm
# Phoenix must use the PostgreSQL database included in appliance backups.
# Without this setting Phoenix falls back to ephemeral SQLite in its container.
PHOENIX_SQL_DATABASE_URL=postgresql://sovereign:change-me@postgres:5432/phoenix
LITELLM_MASTER_KEY=sk-change-me
SOVEREIGN_ADMIN_PASSWORD=change-me-admin-password
SOVEREIGN_RUNTIME_API_KEY=change-me
DOCKER_PROXY_TOKEN=change-me-proxy-token
WORKSPACE_INDEX_ADMIN_TOKEN=change-me-index-token
SOVEREIGN_VAULT_KEY_FILE=/sovereign/secrets/control-vault.key
# Installer stores generated provider configuration under ./secrets so it is
# excluded from normal backups.
LITELLM_CONFIG_PATH=/sovereign/secrets/litellm/config.yaml
LITELLM_CONFIG_HOST_PATH=./secrets/litellm/config.yaml
# Active runtime config file, as seen by Sovereign Control via the /sovereign mount.
RUNTIME_CONFIG_PATH=/sovereign/config/runtime.yaml
# Absolute host path of the deploy directory (used for evals job binds).
DEPLOY_ROOT=/opt/sovereign
# Metal profile: host agent bearer token (written by install-agent.sh)
SOVEREIGN_AGENT_TOKEN=change-me-agent-token
