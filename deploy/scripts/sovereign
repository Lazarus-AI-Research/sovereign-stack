#!/usr/bin/env bash
# Management CLI for an installed SovereignStack appliance.
set -Eeuo pipefail

SOVEREIGN_HOME="${SOVEREIGN_HOME:-$HOME/.sovereign}"
CURRENT="$SOVEREIGN_HOME/current"
ENV_FILE="$SOVEREIGN_HOME/.env"
[[ -d "$CURRENT/deploy" ]] || { echo "error: SovereignStack is not installed at $SOVEREIGN_HOME" >&2; exit 1; }
[[ -f "$ENV_FILE" ]] || { echo "error: $ENV_FILE is missing" >&2; exit 1; }
ENGINE_LIB="$CURRENT/deploy/scripts/container-engine.sh"
[[ -r "$ENGINE_LIB" ]] || { echo "error: container-engine support is missing from the installed release" >&2; exit 1; }
# shellcheck source=container-engine.sh
source "$ENGINE_LIB"

PROFILE="${SOVEREIGN_PROFILE:-$(<"$SOVEREIGN_HOME/state/profile")}"
case "$PROFILE" in
  cuda-x86_64) OVERLAY=cuda ;;
  metal-arm64) OVERLAY=metal ;;
  *) echo "error: unsupported installed profile $PROFILE" >&2; exit 1 ;;
esac

compose() {
  sovereign_engine_require
  sovereign_engine_compose --project-directory "$SOVEREIGN_HOME" --env-file "$ENV_FILE" \
    -f "$CURRENT/deploy/compose/compose.yml" \
    -f "$CURRENT/deploy/compose/compose.runtime.${OVERLAY}.yml" "$@"
}

docker_command() {
  sovereign_engine_require
  sovereign_engine_docker "$@"
}

env_value() { sed -n "s/^$1=//p" "$ENV_FILE" | tail -n 1 | sed 's/^"//;s/"$//'; }
HTTP_PORT="$(env_value HTTP_PORT)"
HTTP_PORT="${HTTP_PORT:-54854}"
HTTPS_PORT="$(env_value HTTPS_PORT)"
HTTPS_PORT="${HTTPS_PORT:-8443}"
OPERATOR_TOKEN="$(env_value SOVEREIGN_OPERATOR_TOKEN)"
CURRENT_ACCESS_MODE="$(env_value SOVEREIGN_ACCESS_MODE)"
CURRENT_ACCESS_MODE="${CURRENT_ACCESS_MODE:-desktop}"

portal_url() {
  local configured mode address
  configured="$(env_value SOVEREIGN_PUBLIC_URL)"
  [[ -n "$configured" ]] && { printf '%s' "${configured%/}"; return; }
  mode="$(env_value SOVEREIGN_ACCESS_MODE)"
  address="$(env_value SOVEREIGN_BIND_ADDRESS)"
  case "${mode:-desktop}" in
    domain) printf 'https://%s' "$(env_value SOVEREIGN_SITE_ADDRESS)" ;;
    lan|wan-http) printf 'http://%s:%s' "${address:-127.0.0.1}" "$HTTP_PORT" ;;
    *) printf 'http://127.0.0.1:%s' "$HTTP_PORT" ;;
  esac
}
BASE_URL="$(portal_url)"

set_env_value() {
  local key="$1" value="$2" temporary
  temporary="$ENV_FILE.tmp.$$"
  awk -v key="$key" -v value="$value" '
    BEGIN { found=0 }
    index($0, key "=")==1 { print key "=" value; found=1; next }
    { print }
    END { if (!found) print key "=" value }
  ' "$ENV_FILE" > "$temporary"
  chmod 600 "$temporary"
  mv "$temporary" "$ENV_FILE"
}

is_private_ipv4() {
  printf '%s\n' "$1" | awk -F. '
    NF==4 && $1==10 { ok=1 }
    NF==4 && $1==192 && $2==168 { ok=1 }
    NF==4 && $1==172 && $2>=16 && $2<=31 { ok=1 }
    END { exit !ok }
  '
}

discover_private_ipv4() {
  local candidates address
  if command -v hostname >/dev/null 2>&1; then candidates="$(hostname -I 2>/dev/null || true)"; fi
  if [[ -z "${candidates:-}" ]] && command -v ipconfig >/dev/null 2>&1; then
    candidates="$(ipconfig getifaddr en0 2>/dev/null || true) $(ipconfig getifaddr en1 2>/dev/null || true)"
  fi
  for address in $candidates; do
    is_private_ipv4 "$address" && { printf '%s' "$address"; return 0; }
  done
  return 1
}

open_url() {
  local url="$1"
  [[ "${SOVEREIGN_NO_OPEN:-0}" != 1 ]] || return 0
  if command -v open >/dev/null 2>&1; then open "$url" >/dev/null 2>&1 || true
  elif command -v xdg-open >/dev/null 2>&1 && [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then xdg-open "$url" >/dev/null 2>&1 || true
  elif command -v cmd.exe >/dev/null 2>&1; then cmd.exe /c start "" "$url" >/dev/null 2>&1 || true
  fi
}

operator_curl() {
  curl -fsS -H "X-Sovereign-Operator-Token: $OPERATOR_TOKEN" "$@"
}

ensure_project_owner() {
  local container owner expected
  expected="$(cd "$SOVEREIGN_HOME" && pwd -P)"
  for container in sovereign-postgres sovereign-runtime sovereign-embeddings sovereign-caddy; do
    docker_command inspect "$container" >/dev/null 2>&1 || continue
    owner="$(docker_command inspect --format '{{ index .Config.Labels "com.docker.compose.project.working_dir" }}' "$container" 2>/dev/null || true)"
    if [[ "$owner" != "$expected" && "${SOVEREIGN_ALLOW_PROJECT_TAKEOVER:-0}" != 1 ]]; then
      echo "error: $container belongs to another SovereignStack installation (${owner:-unknown})" >&2
      echo "stop that installation first; set SOVEREIGN_ALLOW_PROJECT_TAKEOVER=1 only for an intentional migration" >&2
      return 1
    fi
    return 0
  done
}

metal_embedding_label() {
  local file="$SOVEREIGN_HOME/state/embeddinggemma-launchd-label"
  [[ -s "$file" ]] || return 1
  local label="$(<"$file")"
  [[ "$label" == com.lazarus.sovereign-embeddinggemma.* ]] || return 1
  printf '%s' "$label"
}

start_metal_embeddings() {
  [[ "$PROFILE" == metal-arm64 ]] || return 0
  local label plist
  label="$(metal_embedding_label)" || {
    echo "error: the host embeddinggemma service is not installed" >&2
    return 1
  }
  plist="$HOME/Library/LaunchAgents/$label.plist"
  [[ -f "$plist" ]] || { echo "error: missing launchd service $plist" >&2; return 1; }
  if ! launchctl print "gui/$(id -u)/$label" >/dev/null 2>&1; then
    launchctl bootstrap "gui/$(id -u)" "$plist"
  fi
  launchctl kickstart -k "gui/$(id -u)/$label"
}

metal_generation_ready() {
  [[ "$PROFILE" == metal-arm64 ]] || return 0
  [[ -s "$SOVEREIGN_HOME/agent.token" ]] || return 1
  curl -fsS --max-time 5 -H "Authorization: Bearer $(<"$SOVEREIGN_HOME/agent.token")" \
    http://127.0.0.1:9100/agent/manifest 2>/dev/null | \
    grep -Eq '"generation"[^}]*"status"[[:space:]]*:[[:space:]]*"healthy"'
}

start_metal_generation() {
  [[ "$PROFILE" == metal-arm64 ]] || return 0
  local label="com.lazarus.sovereign-runtime-agent"
  local plist="$HOME/Library/LaunchAgents/$label.plist"
  local deadline last_update
  [[ -f "$plist" ]] || { echo "error: missing launchd service $plist" >&2; return 1; }
  if ! launchctl print "gui/$(id -u)/$label" >/dev/null 2>&1; then
    launchctl bootstrap "gui/$(id -u)" "$plist"
  fi
  launchctl kickstart -k "gui/$(id -u)/$label"
  deadline=$((SECONDS + ${SOVEREIGN_AGENT_TIMEOUT:-600}))
  last_update=$SECONDS
  echo "waiting for Metal generation service..."
  until metal_generation_ready; do
    (( SECONDS < deadline )) || {
      tail -n 80 "$SOVEREIGN_HOME/logs/agent.log" 2>/dev/null || true
      echo "error: Metal generation service did not become healthy; data is safe, see $SOVEREIGN_HOME/logs/agent.log" >&2
      return 1
    }
    if (( SECONDS - last_update >= 15 )); then
      echo "Metal generation service is still loading ($((SECONDS + ${SOVEREIGN_AGENT_TIMEOUT:-600} - deadline))s elapsed)..."
      last_update=$SECONDS
    fi
    sleep 2
  done
  echo "Metal generation service: ready"
}

stop_metal_generation() {
  [[ "$PROFILE" == metal-arm64 ]] || return 0
  launchctl bootout "gui/$(id -u)/com.lazarus.sovereign-runtime-agent" 2>/dev/null || true
}

stop_metal_embeddings() {
  [[ "$PROFILE" == metal-arm64 ]] || return 0
  local label
  label="$(metal_embedding_label)" || return 0
  launchctl bootout "gui/$(id -u)/$label" 2>/dev/null || true
}

wait_portal() {
  local deadline=$((SECONDS + ${SOVEREIGN_PORTAL_TIMEOUT:-300}))
  until curl -fsS "$BASE_URL/api/control/v1/health" >/dev/null 2>&1; do
    (( SECONDS < deadline )) || {
      echo "error: the Sovereign portal did not become ready at $BASE_URL" >&2
      return 1
    }
    sleep 2
  done
}

setup_url() {
  local token response path
  token=""
  if [[ "${1:-}" == --renew ]]; then
    response="$(operator_curl -X POST "$BASE_URL/api/control/v1/auth/setup-claim")" || return 1
    path="$(printf '%s' "$response" | sed -n 's/.*"path":"\([^"]*\)".*/\1/p')"
    [[ -n "$path" ]] || { echo "error: Control returned no setup path" >&2; return 1; }
    printf '%s%s' "$BASE_URL" "$path"
    return
  fi
  [[ ! -s "$SOVEREIGN_HOME/state/admin-claim" ]] || token="$(<"$SOVEREIGN_HOME/state/admin-claim")"
  [[ -n "$token" ]] && printf '%s/claim/%s' "$BASE_URL" "$token"
}

open_portal() {
  local target
  if [[ -s "$SOVEREIGN_HOME/state/admin-claim" ]]; then
    target="$(setup_url --renew || setup_url || true)"
  else
    target=""
  fi
  target="${target:-$BASE_URL/}"
  echo "portal: $target"
  open_url "$target"
}

wait_ready() {
  local deadline=$((SECONDS + ${SOVEREIGN_START_TIMEOUT:-2700}))
  local last_update=$SECONDS runtime_state runtime_errors restarted=0 elapsed
  echo "checking model services and runtime readiness..."
  if [[ "$PROFILE" == metal-arm64 ]]; then
    until curl -fsS http://127.0.0.1:42666/healthz >/dev/null 2>&1; do
      (( SECONDS < deadline )) || {
        echo "error: host embeddinggemma did not become ready before timeout" >&2
        return 1
      }
      if (( SECONDS - last_update >= 15 )); then
        elapsed=$((SECONDS + ${SOVEREIGN_START_TIMEOUT:-2700} - deadline))
        echo "EmbeddingGemma: loading (${elapsed}s elapsed)"
        last_update=$SECONDS
      fi
      sleep 2
    done
    echo "EmbeddingGemma: ready"
  else
    until [[ "$(docker_command inspect --format '{{.State.Health.Status}}' sovereign-embeddings 2>/dev/null || true)" == healthy ]]; do
      (( SECONDS < deadline )) || {
        compose logs --tail 120 sovereign-embeddings
        echo "error: embeddinggemma did not become ready before timeout" >&2
        return 1
      }
      sleep 2
    done
  fi
  last_update=$SECONDS
  until docker_command exec sovereign-runtime sovereign-runtime-healthcheck --ready >/dev/null 2>&1; do
    runtime_state="$(operator_curl "$BASE_URL/api/control/v1/runtime/manifest" 2>/dev/null | \
      sed -n 's/.*"state":"\([^"]*\)".*/\1/p' || true)"
    if [[ "$runtime_state" == configuration_error || "$runtime_state" == runtime_error ]]; then
      runtime_errors="$(operator_curl "$BASE_URL/api/control/v1/runtime/errors" 2>/dev/null || true)"
      if [[ "$PROFILE" == metal-arm64 && "$runtime_errors" == *HOST_AGENT_UNREACHABLE* && "$restarted" == 0 ]] && \
        metal_generation_ready; then
        echo "Runtime reported HOST_AGENT_UNREACHABLE after the host recovered; restarting the runtime once..."
        compose restart sovereign-runtime
        restarted=1
        sleep 5
        continue
      fi
      printf '%s\n' "$runtime_errors" >&2
      compose logs --tail 120 sovereign-runtime >&2
      echo "error: runtime entered terminal state ${runtime_state}; data is safe, inspect the error above and $SOVEREIGN_HOME/logs" >&2
      return 1
    fi
    (( SECONDS < deadline )) || {
      compose ps
      compose logs --tail 120 sovereign-runtime
      echo "error: runtime did not become ready before timeout" >&2
      return 1
    }
    if (( SECONDS - last_update >= 15 )); then
      elapsed=$((SECONDS + ${SOVEREIGN_START_TIMEOUT:-2700} - deadline))
      echo "Runtime: ${runtime_state:-starting} (${elapsed}s elapsed)"
      last_update=$SECONDS
    fi
    sleep 5
  done
  echo "Runtime: ready"
}

refresh_gateway_config() {
  local deadline response
  operator_curl -X POST \
    "$BASE_URL/api/control/v1/gateway/config/regenerate" >/dev/null
  operator_curl -X POST \
    "$BASE_URL/api/control/v1/gateway/reload" >/dev/null
  deadline=$((SECONDS + ${SOVEREIGN_GATEWAY_TIMEOUT:-180}))
  until response="$(operator_curl \
    "$BASE_URL/api/control/v1/gateway/status" 2>/dev/null)" && \
    printf '%s' "$response" | grep -q '"healthy":true'; do
    (( SECONDS < deadline )) || {
      echo "error: gateway did not become healthy after configuration reload" >&2
      return 1
    }
    sleep 2
  done
}

api_post_job() {
  local path="$1" body="${2:-}" response job deadline status
  [[ -n "$body" ]] || body='{}'
  response="$(operator_curl -H 'Content-Type: application/json' -d "$body" "$BASE_URL/api/control/v1$path")"
  job="$(printf '%s' "$response" | sed -n 's/.*"job_id":"\([^"]*\)".*/\1/p')"
  [[ -n "$job" ]] || { printf '%s\n' "$response"; return 0; }
  echo "job: $job"
  deadline=$((SECONDS + 3600))
  while (( SECONDS < deadline )); do
    response="$(operator_curl "$BASE_URL/api/control/v1/jobs/$job")"
    status="$(printf '%s' "$response" | sed -n 's/.*"status":"\([^"]*\)".*/\1/p')"
    case "$status" in
      succeeded) printf '%s\n' "$response"; return 0 ;;
      failed) printf '%s\n' "$response" >&2; return 1 ;;
    esac
    sleep 2
  done
  echo "error: job $job timed out" >&2
  return 1
}

configure_access() {
  local mode="${1:-}" target="${2:-}" acknowledgement="${3:-}" bind site public http_port https_port plain_http plain_https
  plain_http="$HTTP_PORT"; plain_https="$HTTPS_PORT"
  if [[ "$CURRENT_ACCESS_MODE" == domain ]]; then plain_http=54854; plain_https=8443; fi
  case "$mode" in
    desktop)
      bind=127.0.0.1; site=:80; http_port="$plain_http"; https_port="$plain_https"
      public="http://127.0.0.1:$http_port"
      ;;
    lan)
      [[ -n "$target" ]] || target="$(discover_private_ipv4)" || {
        echo "error: no private LAN address was detected; pass one explicitly" >&2
        return 1
      }
      is_private_ipv4 "$target" || { echo "error: $target is not an RFC1918 private IPv4 address" >&2; return 1; }
      bind="$target"; site=:80; http_port="$plain_http"; https_port="$plain_https"
      public="http://$target:$http_port"
      ;;
    domain)
      [[ -n "$target" && "$target" != *://* && "$target" != */* && "$target" == *.* ]] || {
        echo "usage: sovereign access domain <hostname>" >&2; return 2
      }
      bind=0.0.0.0; site="$target"; http_port=80; https_port=443; public="https://$target"
      ;;
    wan-http)
      [[ "$acknowledgement" == --i-understand-this-is-insecure ]] || {
        echo "error: public cleartext HTTP exposes login sessions; use a domain with TLS or add --i-understand-this-is-insecure" >&2
        return 2
      }
      [[ -n "$target" && "$target" != *://* && "$target" != */* ]] || {
        echo "usage: sovereign access wan-http <public-host-or-ip> --i-understand-this-is-insecure" >&2; return 2
      }
      bind=0.0.0.0; site=:80; http_port="$plain_http"; https_port="$plain_https"
      public="http://$target:$http_port"
      ;;
    *) echo "usage: sovereign access desktop|lan [private-ip]|domain <hostname>|wan-http <host> --i-understand-this-is-insecure" >&2; return 2 ;;
  esac
  set_env_value SOVEREIGN_ACCESS_MODE "$mode"
  set_env_value SOVEREIGN_BIND_ADDRESS "$bind"
  set_env_value SOVEREIGN_SITE_ADDRESS "$site"
  set_env_value SOVEREIGN_PUBLIC_URL "$public"
  if [[ "$mode" == wan-http ]]; then
    set_env_value SOVEREIGN_INSECURE_WAN_ACK I-understand-cleartext-http-is-insecure
  else
    set_env_value SOVEREIGN_INSECURE_WAN_ACK ""
  fi
  set_env_value HTTP_PORT "$http_port"
  set_env_value HTTPS_PORT "$https_port"
  printf '%s\n' "$mode" > "$SOVEREIGN_HOME/state/access-mode"
  chmod 600 "$SOVEREIGN_HOME/state/access-mode"
  BASE_URL="$public"
  HTTP_PORT="$http_port"
  HTTPS_PORT="$https_port"
  CURRENT_ACCESS_MODE="$mode"
  compose up -d caddy
  wait_portal
  echo "access mode: $mode"
  echo "portal: $BASE_URL/"
}

usage() {
  cat <<'EOF'
Usage: sovereign <command> [options]

  up                         Pull, start, wait, and run the smoke suite
  start                      Start only the control portal
  open                       Open the portal (or first-admin setup) in a browser
  url                        Print the portal URL
  access desktop             Bind the portal to this computer only
  access lan [private-ip]    Bind to a private LAN address
  access domain <hostname>   Publish with automatic HTTPS
  access wan-http <host> --i-understand-this-is-insecure
                             Explicitly publish cleartext HTTP
  admin setup-link           Create a fresh 30-minute first-admin link
  down                       Stop the appliance without deleting data
  status                     Show containers and the product health endpoint
  logs [compose log args]    Show or follow service logs
  smoke [suite]              Run a named eval suite (default: smoke)
  backup                     Create and verify a backup
  restore <id> --yes         Restore a verified backup
  bundle create [options]    Create a same-platform offline bundle
  bundle install <archive>   Install a same-platform offline bundle
  validate                   Validate the resolved Compose configuration
  update <version>           Back up and install a signed release; roll back on failure
  uninstall [--purge]        Remove the appliance; preserve data by default
  version                    Print the installed version
EOF
}

case "${1:-help}" in
  start)
    ensure_project_owner
    # Bring up the smallest useful product surface first. Compose follows the
    # caddy dependencies to Postgres, Control, and Workspace, but it does not
    # wait for inference weights or optional observability services.
    if [[ ! -f "$SOVEREIGN_HOME/state/offline" ]]; then
      compose pull caddy postgres sovereign-control sovereign-workspace
    fi
    compose up -d caddy
    wait_portal
    open_portal
    echo "portal ready: $BASE_URL/"
    ;;
  up)
    ensure_project_owner
    start_metal_generation
    start_metal_embeddings
    if [[ ! -f "$SOVEREIGN_HOME/state/offline" ]]; then compose pull; fi
    compose up -d --remove-orphans
    wait_portal
    open_portal
    wait_ready
    refresh_gateway_config
    if [[ "${SOVEREIGN_SKIP_SMOKE:-0}" != 1 ]]; then
      compose --profile tools run --rm sovereign-evals suite smoke --report-dir /sovereign/reports
    fi
    echo "ready: $BASE_URL/"
    ;;
  open)
    wait_portal
    open_portal
    ;;
  url) printf '%s/\n' "$BASE_URL" ;;
  access)
    shift
    configure_access "${1:-}" "${2:-}" "${3:-}"
    ;;
  admin)
    case "${2:-}" in
      setup-link)
        wait_portal
        link="$(setup_url --renew)"
        printf '%s\n' "$link"
        ;;
      *) echo "usage: sovereign admin setup-link" >&2; exit 2 ;;
    esac
    ;;
  down)
    compose down
    stop_metal_embeddings
    stop_metal_generation
    ;;
  status)
    compose ps
    if [[ "$PROFILE" == metal-arm64 ]]; then
      curl -fsS http://127.0.0.1:42666/healthz || true
      echo
    fi
    curl -fsS "$BASE_URL/api/control/v1/health" || true
    echo
    ;;
  logs) shift; compose logs "$@" ;;
  smoke)
    suite="${2:-smoke}"
    compose --profile tools run --rm sovereign-evals suite "$suite" --report-dir /sovereign/reports
    ;;
  backup)
    backup_result="$(api_post_job /backups '{}')"
    printf '%s\n' "$backup_result"
    backup_id="$(printf '%s\n' "$backup_result" | sed -n 's/.*"backup_id":"\([^"]*\)".*/\1/p' | tail -n 1)"
    [[ -n "$backup_id" ]] || { echo "error: backup job returned no backup_id" >&2; exit 1; }
    verification="$(operator_curl -H 'Content-Type: application/json' -d '{}' \
      "$BASE_URL/api/control/v1/backups/$backup_id/verify")"
    printf '%s\n' "$verification"
    printf '%s' "$verification" | grep -q '"valid":true' || {
      echo "error: backup $backup_id failed verification" >&2
      exit 1
    }
    ;;
  restore)
    [[ -n "${2:-}" && "${3:-}" == --yes ]] || { echo "usage: sovereign restore <backup-id> --yes" >&2; exit 2; }
    api_post_job "/backups/$2/restore" '{}'
    ;;
  bundle)
    case "${2:-}" in
      create) shift 2; SOVEREIGN_HOME="$SOVEREIGN_HOME" "$CURRENT/deploy/scripts/create-offline-bundle.sh" "$@" ;;
      install)
        [[ -f "${3:-}" ]] || { echo "usage: sovereign bundle install <archive>" >&2; exit 2; }
        SOVEREIGN_HOME="$SOVEREIGN_HOME" "$CURRENT/deploy/scripts/install.sh" --offline-bundle "$3" --profile "$PROFILE"
        ;;
      *) echo "usage: sovereign bundle create|install" >&2; exit 2 ;;
    esac
    ;;
  validate) compose config -q && echo "Compose configuration valid ($PROFILE)" ;;
  update)
    target_version="${2:-}"
    target_version="${target_version#v}"
    [[ "$target_version" =~ ^[0-9]+\.[0-9]+\.[0-9]+([-+][0-9A-Za-z.-]+)?$ ]] || {
      echo "usage: sovereign update <version>" >&2; exit 2
    }
    previous_release="$(cd "$CURRENT" && pwd -P)"
    echo "creating pre-update backup..."
    SOVEREIGN_HOME="$SOVEREIGN_HOME" "$CURRENT/deploy/scripts/sovereign" backup
    echo "installing signed release $target_version..."
    if SOVEREIGN_HOME="$SOVEREIGN_HOME" SOVEREIGN_VERSION="$target_version" \
      SOVEREIGN_SKIP_HOSTD_INSTALL=1 "$CURRENT/deploy/scripts/install.sh" --version "$target_version"; then
      echo "updated to $target_version"
    else
      echo "update failed; restoring $previous_release" >&2
      ln -sfn "$previous_release" "$SOVEREIGN_HOME/current"
      SOVEREIGN_HOME="$SOVEREIGN_HOME" "$previous_release/deploy/scripts/sovereign" up || true
      exit 1
    fi
    ;;
  uninstall) shift; SOVEREIGN_HOME="$SOVEREIGN_HOME" "$CURRENT/deploy/scripts/uninstall.sh" "$@" ;;
  version) if [[ -f "$CURRENT/VERSION" ]]; then cat "$CURRENT/VERSION"; else env_value SOVEREIGN_VERSION; fi ;;
  help|-h|--help) usage ;;
  *) usage >&2; exit 2 ;;
esac
