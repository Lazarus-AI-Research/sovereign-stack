# SovereignStack has one customer-facing origin. The installer selects the
# address: loopback, private LAN HTTP, or a public domain with automatic TLS.
{$SOVEREIGN_SITE_ADDRESS::80} {
	encode zstd gzip

	route {
		# Control owns the appliance API and portal shell.
		handle /api/control/* {
			reverse_proxy sovereign-control:8080
		}

		# Branding is intentionally public so login and invite screens are themed.
		handle /branding/* {
			root * /srv
			file_server
		}

		# Embedded Workspace. AnythingLLM 1.15 emits root-relative assets, API
		# calls, websocket paths, and client routes, so route those back into the
		# same authenticated upstream while the iframe itself begins at /apps/chat.
		@workspace path /apps/chat/* /api/* /socket.io/* /workspace* /settings* /login* /sso* /invite* /index.js /index.css /favicon.png /logo.png /manifest.json /assets/* /uploads/*
		handle @workspace {
			forward_auth sovereign-control:8080 {
				uri /api/control/v1/auth/forward
				copy_headers X-Sovereign-User X-Sovereign-Role
			}
			uri strip_prefix /apps/chat
			reverse_proxy sovereign-workspace:3001 {
				header_down -X-Frame-Options
				header_down -Content-Security-Policy
				header_down +Content-Security-Policy "frame-ancestors 'self'"
			}
		}

		# Observability applications stay private and share the Control session.
		handle /apps/grafana/* {
			forward_auth sovereign-control:8080 {
				uri /api/control/v1/auth/forward/manager
				copy_headers X-Sovereign-User X-Sovereign-Role
			}
			reverse_proxy grafana:3000 {
				header_down -X-Frame-Options
				header_down -Content-Security-Policy
				header_down +Content-Security-Policy "frame-ancestors 'self'"
			}
		}

		handle /apps/phoenix/* {
			forward_auth sovereign-control:8080 {
				uri /api/control/v1/auth/forward/manager
				copy_headers X-Sovereign-User X-Sovereign-Role
			}
			reverse_proxy phoenix:6006 {
				header_down -X-Frame-Options
				header_down -Content-Security-Policy
				header_down +Content-Security-Policy "frame-ancestors 'self'"
			}
		}

		# Compatibility bookmark from pre-portal releases.
		redir /control / 308
		redir /control/* / 308

		handle {
			reverse_proxy sovereign-control:8080
		}
	}
}
