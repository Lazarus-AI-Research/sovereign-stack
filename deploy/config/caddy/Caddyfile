# Sovereign Stack ingress. v0.1 binds Caddy to host loopback, so local HTTP is
# intentional; remote exposure requires an operator-managed TLS reverse proxy.

:80 {
	# Sovereign Control admin UI and API
	redir /control /control/
	handle /control/* {
		uri strip_prefix /control
		reverse_proxy sovereign-control:8080
	}
	handle /api/control/* {
		reverse_proxy sovereign-control:8080
	}

	# Branding assets
	handle /branding/* {
		root * /srv
		file_server
	}

	# Sovereign Workspace (default UI)
	handle {
		reverse_proxy sovereign-workspace:3001
	}
}
