{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lazarus.ai/sovereign/release-manifest.schema.json",
  "title": "SovereignStack release manifest",
  "type": "object",
  "required": ["schema_version", "version", "stack_commit", "runtime_version", "runtime_commit", "supported_profiles", "images", "models", "metal_agent", "embedding_runtime", "installer_dependencies", "schemas"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.2" },
    "version": { "type": "string", "pattern": "^0\\.1\\.0(?:-rc\\.[0-9]+)?$" },
    "stack_commit": { "$ref": "#/$defs/commit" },
    "runtime_version": { "type": "string", "pattern": "^0\\.1\\.0(?:-rc\\.[0-9]+)?$" },
    "runtime_commit": { "$ref": "#/$defs/commit" },
    "created_at": { "type": "string", "format": "date-time" },
    "supported_profiles": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "enum": ["cuda-x86_64", "metal-arm64"] }
    },
    "images": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/image" } },
    "models": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/model" } },
    "metal_agent": { "$ref": "#/$defs/signedArtifact" },
    "embedding_runtime": { "$ref": "#/$defs/versionedArtifact" },
    "installer_dependencies": {
      "type": "object",
      "required": ["metal-arm64"],
      "additionalProperties": false,
      "properties": {
        "metal-arm64": {
          "type": "object",
          "required": ["colima", "lima", "docker_cli", "docker_compose"],
          "additionalProperties": false,
          "properties": {
            "colima": { "$ref": "#/$defs/installerDependency" },
            "lima": { "$ref": "#/$defs/installerDependency" },
            "docker_cli": { "$ref": "#/$defs/installerDependency" },
            "docker_compose": { "$ref": "#/$defs/installerDependency" }
          }
        }
      }
    },
    "schemas": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifact" } },
    "assets": { "type": "array", "items": { "$ref": "#/$defs/asset" } }
  },
  "$defs": {
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "image": {
      "type": "object",
      "required": ["name", "reference", "digest", "platforms", "first_party"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "reference": { "type": "string" },
        "digest": { "$ref": "#/$defs/digest" },
        "platforms": { "type": "array", "minItems": 1, "items": { "enum": ["linux/amd64", "linux/arm64"] } },
        "first_party": { "type": "boolean" }
      }
    },
    "model": {
      "type": "object",
      "required": ["id", "repository", "revision", "profiles"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "repository": { "type": "string" },
        "revision": { "$ref": "#/$defs/commit" },
        "artifact": { "type": "string" },
        "artifacts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifact" } },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "profiles": { "type": "array", "items": { "enum": ["cuda-x86_64", "metal-arm64"] } },
        "role": { "enum": ["generation", "embedding"] },
        "modalities": { "type": "array", "items": { "enum": ["text", "image", "audio", "video"] } }
      }
    },
    "asset": {
      "type": "object",
      "required": ["name", "sha256", "bytes"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "bytes": { "type": "integer", "minimum": 0 },
        "signature": { "type": "string" },
        "sbom": { "type": "string" }
      }
    },
    "artifact": {
      "type": "object",
      "required": ["name", "sha256", "bytes"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "versionedArtifact": {
      "type": "object",
      "required": ["version", "artifact", "url", "sha256", "bytes"],
      "additionalProperties": false,
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "artifact": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "installerDependency": {
      "type": "object",
      "required": ["version", "artifact", "url", "sha256", "bytes", "format"],
      "additionalProperties": false,
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "artifact": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "signature_url": { "type": "string", "format": "uri" },
        "signer_identity_regexp": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "bytes": { "type": "integer", "minimum": 1 },
        "format": { "enum": ["executable", "tar.gz"] }
      },
      "dependentRequired": {
        "signature_url": ["signer_identity_regexp"],
        "signer_identity_regexp": ["signature_url"]
      }
    },
    "signedArtifact": {
      "type": "object",
      "required": ["version", "repository", "artifact", "url", "signature_url", "sha256", "bytes", "signer_identity_regexp"],
      "additionalProperties": false,
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "minLength": 1 },
        "artifact": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "signature_url": { "type": "string", "format": "uri" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "bytes": { "type": "integer", "minimum": 1 },
        "signer_identity_regexp": { "type": "string", "minLength": 1 }
      }
    }
  }
}
