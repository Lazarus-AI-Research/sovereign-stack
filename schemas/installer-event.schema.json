{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lazarus.ai/sovereign/installer-event.schema.json",
  "title": "SovereignStack installer event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sequence",
    "timestamp",
    "version",
    "profile",
    "stage",
    "status",
    "message",
    "data_safe",
    "recovery",
    "component",
    "current_bytes",
    "total_bytes"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "sequence": { "type": "integer", "minimum": 1 },
    "timestamp": { "type": "string", "format": "date-time" },
    "version": { "type": "string", "minLength": 1 },
    "profile": { "type": "string", "minLength": 1 },
    "stage": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "status": {
      "type": "string",
      "enum": ["started", "progress", "waiting", "failed", "completed"]
    },
    "message": { "type": "string" },
    "data_safe": { "type": "boolean" },
    "recovery": { "type": "string" },
    "component": { "type": "string" },
    "current_bytes": { "type": "integer", "minimum": 0 },
    "total_bytes": { "type": "integer", "minimum": 0 }
  }
}
